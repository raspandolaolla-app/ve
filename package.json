{
  "name": "raspando-la-olla",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:mobile": "playwright test --project='Mobile Chrome' --project='Mobile Safari'",
    "test:auth": "playwright test e2e/auth",
    "test:games": "playwright test e2e/games",
    "test:wallet": "playwright test e2e/wallet",
    "test:bingo": "playwright test e2e/games/bingo.spec.ts",
    "test:domino": "playwright test e2e/games/domino.spec.ts",
    "test:truco": "playwright test e2e/games/truco.spec.ts",
    "test:a11y": "playwright test --project=accessibility",
    "test:a11y:report": "playwright test --project=accessibility --reporter=html",
    "test:integration": "playwright test e2e/integration",
    "test:smoke": "playwright test e2e/smoke",
    "test:all": "npm run test && npm run test:a11y",
    "test:setup-db": "tsx scripts/setup-test-users.ts",
    "test:cleanup-db": "tsx scripts/cleanup-test-data.ts",
    "test:report-gen": "tsx scripts/generate-test-report.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@supabase/supabase-js": "^2.112.4",
    "@tailwindcss/vite": "^4.1.14",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^5.0.4",
    "chess.js": "^1.4.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "otpauth": "^9.5.2",
    "pg": "^8.23.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
